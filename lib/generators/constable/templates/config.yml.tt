# .constable/config.yml
#
# Every setting Constable has, and the only place any of them is set.
#
# There is deliberately no second home. Settings used to be settable here *and* in
# `Constable.configure`, which bought a precedence rule to learn and the same setting
# documented twice in two files. Assigning one in Ruby now raises and says to come here.
#
# `test/case_helper.rb` is for code: tier base classes, `before_suite`/`after_suite`
# hooks, matcher definitions. Things a YAML file cannot hold.
#
# This file is run through ERB before it is parsed, exactly as Rails does for
# database.yml, so a value that has to be computed still can be -- an env var with a
# default, say. See the README for the syntax; it is not written out here because ERB is
# applied to the whole file, comments included, so an example in a comment is live code.
#
# A CLI flag beats this file for a single run. Every key below is shown at its default,
# so this doubles as the reference -- delete anything you have not changed, the behaviour
# is identical either way. Re-run `rails generate constable:install --skip` after
# upgrading and any settings added since will be appended, leaving your values alone.

# Cold cases -- adopting an existing RSpec or Minitest suite -- are NOT configured here.
#
# They are declared in the Constable.cold_cases block in test/case_helper.rb, which
# `constable import` fills in:
#
#     Constable.cold_cases do
#       rspec "spec/**/*_spec.rb"
#     end
#
# That is the one setting with a home outside this file, and the reason is visibility.
# Linking a legacy suite decides what `constable test` runs at all, and as a key in here it
# was invisible: the first run executed a thousand specs with nothing in the test tree to
# say why. A file can be seen, read and deleted.

# The blotter: flake history, the jail docket, warrants.
#
# NOT your application's database, and nothing to do with it. Your tests keep using
# whatever config/database.yml says -- Postgres stays Postgres. This is a separate file
# holding Constable's own bookkeeping, and it never contains a row of your data. Leaving
# it on SQLite is right even for a Postgres app.
#
# Constable owns this store outright. It is deliberately not the app's own
# database, for two reasons. Native cases run inside a transaction that gets
# rolled back, so writing "this test just failed" through that connection would
# roll the record back too. And :unit-tier runs skip booting the database
# entirely for speed -- requiring a live server to record a pass would undo that.
#
# SQLite in WAL mode handles the real workload (a handful of tables, one row per
# test per run) comfortably. Point it at Postgres or MySQL only if you genuinely
# need one queryable store shared across many CI machines -- and always at a
# separate database from the app's own, never its test connection.
storage:
  adapter: sqlite                      # sqlite (default, and right for almost everyone)
                                       #   postgres / mysql: only when many CI machines
                                       #   need to share ONE blotter. Always a separate
                                       #   database from your app's own.
  path: .constable/constable.sqlite3   # sqlite only
  url:                                 # postgres/mysql only, e.g.
                                       #   postgres://user:pass@host/constable_metadata

# Put a test on the docket by itself when it passed last run and failed this one, with no
# code change in between. Off by default, and the reason is what jailing *does*: a jailed
# test is skipped on every later run. Turning that on automatically means a suite quietly
# stops running tests nobody chose to stop running -- and a suite with order-dependent
# tests, which is most large ones, trips it constantly. `constable test --jail` still
# jails failures, because that is a thing you asked for.
jail_flakes: false

warrants: false          # opt-in flaky detector -- rerun a failure in isolation before believing it
warrant_retries: 5       # reruns before declaring a warrant (flaky) or a genuine failure
auto_relink: false       # auto-confirm high-confidence rename detection instead of suggesting it

parole_period: 10        # consecutive clean runs before a paroled test is auto-released

coverage: false          # record coverage during test runs
coverage_threshold: 90   # diff-based -- only lines changed in the current diff are held to it
coverage_html: false     # generate a browsable report by default

fail_on_warnings: false  # CI: fail the build when the warning count doesn't trend down

# Seconds before one item is declared hung, failed by name, and the run allowed to carry on.
#
# Always on. There is no value that turns it off, and the floor is 10 seconds.
#
# A test that never finishes does not fail -- it parks the run, and the only symptom is a
# terminal that sits there. No output, nothing recorded, and no way to tell which of a
# thousand files is responsible. Measured once at 58 minutes of wall clock against 10
# minutes of CPU, with nothing to show for it.
#
# Raise it for a suite with genuinely slow files. An item is a whole file for a cold case,
# so this is the budget for the file, not for one test: on one real suite 60 files take more
# than 10 seconds and the slowest takes 266.
timeout: 300

# Seconds between "still going" lines while a run streams. 0 is off.
#
# A suite that takes half an hour gives no sign of how far in it is: you step away, come
# back, and cannot tell whether it has been running ten minutes or forty. Every N seconds
# the stream says how long it has been going, how many tests are done, and what it is on.
#
# Time-based rather than per-test on purpose -- a fast suite never prints one, and a slow
# one prints a handful rather than a wall.
#
# This is also settable per developer in .constable/preferences.yml, which is gitignored,
# so wanting a clock does not mean committing one for everybody.
heartbeat: 0

# How many rows the SLOWEST section prints after a run.
slowest: 5

parallel_workers: auto   # or an explicit integer

# How a parallel worker gets a database of its own.
#
# Sharing one is not a speed/safety trade, it is a correctness bug: on SQLite the run
# dissolves into "database is locked", and on a client/server database tests quietly see
# each other's rows, which is worse because it looks like it worked.
#
# Three options:
#
#   schema   Rebuild <database>_<index> from schema.rb on every run.
#            What Rails itself does for `rails test`. Correct by construction -- the
#            databases cannot drift, because they are thrown away and rebuilt. The right
#            default, and the wrong choice only when it is slow or impossible.
#
#   reuse    Keep <database>_<index> between runs, building it only when it is missing.
#            Two reasons to want this:
#              * Speed. A large schema is not replayed once per worker per run. On
#                Postgres the databases are cloned in one statement
#                (CREATE DATABASE ... TEMPLATE), which is far faster than a schema load.
#              * It is the ONLY option that works when your schema cannot rebuild the
#                database by itself -- true of any app with Postgres custom types, since
#                CREATE TYPE has no schema.rb representation and a from-scratch load
#                fails on a dump that references types it never defines.
#            The cost: keeping those databases current is now your job. Run
#            `constable prepare` after a migration.
#
#   off      Do not shard, so do not fork. An explicit serial run: no attempt to build
#            anything, and no warning about it. Correct, and as slow as one core.
#
worker_databases: schema   # schema (rebuild each run) | reuse (keep them) | off (serial)

# How much the live stream says while the suite is running. The summary at the end is
# identical either way -- this only changes what you watch on the way there.
#
#   concise    One glyph per test, grouped into a run per case. A thousand tests stay
#              inside one screen, and a wall of green is the point.
#   expanded   A line per test: glyph, description, duration. Slower to read in bulk, but
#              you can see which test is hanging while it hangs, rather than afterwards.
#
output: concise          # concise (one glyph per test) | expanded (a line per test)

# Fallback path-based tier inference, used only when a case doesn't inherit from
# a tiered base class. The base classes in test/case_helper.rb are the primary
# mechanism and always win -- this is here so an un-migrated file still lands in
# a sensible tier rather than the slowest one.
tiers:
  unit:        "test/cases/models/**/*"
  integration: "test/cases/controllers/**/*"
  system:      "test/cases/system/**/*"

# Defaults for `constable modernize`, so a port is one command rather than five flags.
#
# A port is the same invocation run repeatedly against different directories, and
# repeating the flags each time is how one eventually gets left off -- `delete` without
# `base` moves a whole directory into classes that inherit none of your tier setup, and
# the first sign of it is `NoMethodError: undefined method 'create'`. Set them once.
#
# A flag on the command line still wins: the file says what this project does by default,
# the flag says what this invocation does instead.
modernize:
  base:   null    # superclass for converted cases, e.g. UnitCase. null means Constable::Case
  port:   false   # write into test/cases/, mirroring the spec path
  delete: false   # remove each original once its port has been written
  batch:  null    # port this many files per run; null means all of them
