# frozen_string_literal: true

# Loaded once by `constable test`, before any case file -- the equivalent of RSpec's
# spec_helper.rb + rails_helper.rb. Individual cases never require it themselves.
#
# Settings that are *values* (a number, a flag, a glob) live in .constable/config.yml,
# where a CLI flag can override them for one run without editing Ruby. This file is for
# the things that have to be code: tier base classes, hooks, matchers.

ENV["RAILS_ENV"] ||= "test"

require_relative "../config/environment"
require "constable"

# A suite that can reach production data is one that will eventually destroy some.
abort("The Rails environment is running in production mode!") if Rails.env.production?

# Loads db/schema.rb when it has drifted behind your migrations -- the same thing
# `rails test` does. Without it the first case to touch the database fails with
# "no such table", which tells you nothing about the test you wrote.
if defined?(ActiveRecord::Migration)
  begin
    ActiveRecord::Migration.maintain_test_schema!
  rescue ActiveRecord::PendingMigrationError => error
    abort("#{error.message}\n\nRun: bin/rails db:migrate RAILS_ENV=test")
  end
end

# Shared modules and custom matchers. Sorted, because Dir[] returns filesystem order and
# that differs between your laptop and CI. Loaded before the tier classes below so they
# can `include` from here.
Dir[Rails.root.join("test/support/**/*.rb")].sort.each { |f| require f }

# --- Tiers -------------------------------------------------------------------------
#
# A tier says how much of the stack a case needs. Declare it once on a base class and
# let ordinary Ruby inheritance carry it down:
#
#     class UsersController::CreatesUserCase < IntegrationCase
#
# Anything a whole tier needs belongs on these classes -- factories, auth helpers, a job
# adapter. `constable modernize --base IntegrationCase` ports files into them.

# Guarded so a suite with no factory gem still boots. Without this include, a converted
# case dies on `NoMethodError: undefined method 'create'`.
module CaseFactories
  include FactoryBot::Syntax::Methods if defined?(FactoryBot::Syntax::Methods)
end

# Per-test cleanup that your RSpec suite does in an `after(:each)` hook.
#
# Native cases are not RSpec and do not run RSpec hooks, so anything spec/support does
# per test does not happen for them. That costs nothing until a part-ported directory
# puts a native case and a cold case in the same process -- then a memoized singleton
# built inside one case's transaction survives the rollback as an unsaved record, and the
# next cold case reads it and fails somewhere unrelated. Mirror that cleanup here.
module CaseCleanup
  def self.included(base)
    base.teardown do
      # SomeSingleton.reset!
      # Fakes::Service.clean!
    end
  end
end

# No database, no request stack, no browser -- just Ruby. The fastest thing Constable
# runs, and where most of a suite should live.
class UnitCase < Constable::Case
  include CaseFactories
  include CaseCleanup

  tier :unit
end

# get/post/patch/delete, `response`, `follow_redirect!`, cookies, and every URL helper
# your routes define. Each investigation runs inside a transaction, rolled back after.
class IntegrationCase < Constable::Case
  include Constable::RailsSupport::Integration
  include CaseFactories
  include CaseCleanup

  tier :integration
end

# The browser instead of the request stack: Capybara's visit/click_on/fill_in/page.
class SystemCase < Constable::Case
  include CaseFactories
  include CaseCleanup

  # Capybara is not a Constable dependency -- a suite with no browser tests should not
  # need a driver installed to boot.
  include Constable::RailsSupport::System if defined?(Capybara)

  tier :system

  # driven_by :selenium, using: :headless_chrome, screen_size: [1400, 1400]
end

# --- Configuration that has to be code ---------------------------------------------
#
# Every *setting* -- workers, output, coverage, warrants, cold_cases -- is documented and
# set in .constable/config.yml. It is not repeated here, because two homes for one setting
# means learning which one wins.
#
# `storage` and `modernize` are the two that can only live there: both are read before
# this file runs -- the blotter so `constable jail` works without booting the app, and
# modernize because it never boots one at all -- so setting either here raises rather than
# being quietly ignored. CONSTABLE_STORAGE_URL overrides the blotter location per run.
#
# What belongs here is what a YAML file cannot express.

Constable.configure do |c|
  # Settings do not go here. Every one of them lives in .constable/config.yml, and
  # assigning one on this block raises rather than being quietly ignored. If you came
  # here wanting a value computed at boot, that file is run through ERB:
  #
  #     parallel_workers: <%%= ENV.fetch("CI_WORKERS", 4) %>

  # Run once per process, before the whole suite. For configuring the world -- drivers,
  # adapters, formats -- and deliberately not for creating records that tests then share.
  #
  # c.before_suite do
  #   Capybara.default_driver = :rack_test
  # end
  #
  # c.after_suite { SomeExternalHarness.shut_down }

  # Custom matchers, though test/support/matchers.rb is the better home once there is
  # more than one:
  #
  # Constable::Matchers.define(:be_created) { |response| response.status == 201 }
end

# Two things are absent on purpose.
#
# There is no before(:all) here, and no one-time fixture hook.
#
# A before(:all) builds state once and hands the same objects to many tests. That is
# faster right up until one test mutates one of them -- and then you have a failure that
# depends on order, appears on one machine, and is not reproducible from anything written
# down. `briefing` runs before every investigation instead, against a fresh instance in a
# transaction that is rolled back. When that is genuinely too slow the fix is a cheaper
# fixture -- build_stubbed over create -- not state shared across tests.
#
# And `witness` memoizes per test, and never per process. Naming it five times in one
# investigation hits the database once; the moment that investigation ends the memo is
# gone. Caching across tests would be faster and would reintroduce exactly the shared,
# mutable, order-dependent state the paragraph above exists to prevent.
